{
  // Modalità backend LLM: "Ollama" | "OpenAiCompatible"
  // "Ollama"           — si connette ad un'istanza Ollama nativa (usa /api/tags per i modelli)
  // "OpenAiCompatible" — si connette ad un server con API OpenAI (usa /v1/models, supporta ApiKey)
  "BackendMode": "OpenAiCompatible",

  // ── Ollama (BackendMode = "Ollama") ────────────────────────────────────────────
  // URL base dell'istanza Ollama locale
  "OllamaHost": "http://95.110.230.23:11434", //"http://localhost:11434",
  // Timeout in secondi per le richieste a Ollama. 0 = nessun timeout (infinito).
  "OllamaTimeoutSeconds": 0,

  // ── OpenAI-compatible (BackendMode = "OpenAiCompatible") ──────────────────────
  "OpenAiCompatible": {
    // URL base del server OpenAI-compatible (es. LM Studio, Ollama proxy, Together AI...)
    "Url": "http://95.110.230.23:11434",
    // API key (opzionale). Lasciare vuoto se il server non richiede autenticazione.
    "ApiKey": "",
    // Timeout in secondi. 0 = nessun timeout.
    "TimeoutSeconds": 0
  },

  "MetronomoMCP": {
    // Endpoint MCP di MetronomoMCP (deve corrispondere a HttpUrl + /mcp in appsettings di MetronomoMCP)
    "Url": "http://localhost:5100/mcp",
    // Secondi di attesa prima di tentare la connessione, per dare tempo a MetronomoMCP di avviarsi
    // Impostare a 0 se MetronomoMCP è già in esecuzione prima di avviare OllamaChatter
    "StartupDelaySeconds": 5,
    // Modalità di esposizione dei tool MCP ad Ollama.
    // "Always"  — i tool vengono sempre inviati al modello (default)
    // "Never"   — i tool non vengono mai inviati (chat semplice senza MCP tools)
    // "Ask"     — chiede interattivamente all'avvio se si vogliono abilitare
    "ToolMode": "Always",
    // Forza il modello a chiamare un tool prima di rispondere.
    // "auto"     — il modello decide autonomamente (default OpenAI; molti modelli locali lo ignorano)
    // "required" — il modello DEVE chiamare almeno un tool (consigliato per modelli che ignorano i tool)
    // "none"     — disabilita i tool anche se ToolMode=Always
    "ToolChoice": "required"
  },
  // Modello da usare senza chiedere all'avvio. Lasciare vuoto per mostrare la selezione.
  // Se il modello non è disponibile sul server, la selezione viene mostrata comunque.
  "DefaultModel": "llama3.1:8b",

  // Parametri di inferenza inviati al modello ad ogni richiesta.
  // temperature: 0 = deterministico (consigliato per SQL), 1 = massima creatività
  // top_p:       0–1, filtra i token meno probabili (0.1 = output molto deterministico)
  // num_ctx:     dimensione context window in token (0 = usa il default del server)
  "LlmParameters": {
    "Temperature": 0.0,
    "TopP": 0.1,
    "NumCtx": 8192
  },

  // System prompt inviato a Ollama all'inizio di ogni conversazione
  // Il contesto business e di pianificazione viene aggiunto automaticamente in coda a questo testo
  "SystemPrompt": "Sei un assistente con accesso a un database SQL Server tramite MetronomoMCP. REGOLA FONDAMENTALE: per qualsiasi domanda che richieda dati reali (numeri, elenchi, conteggi, valori) devi OBBLIGATORIAMENTE chiamare il tool execute_query prima di rispondere. Non rispondere mai con dati senza aver prima eseguito una query. Usa: execute_query per eseguire query SQL, list_tables per elencare le tabelle, describe_table per vedere la struttura di una tabella."
}
